[Unit]
Description=ONVIF virtual cameras
Requires=bridge-network.service
After=network-online.target bridge-network.service rtsp-bridge.service
PartOf=onvif-rtsp-bridge.target

[Service]
Type=simple
User=onvif-bridge
Group=onvif-bridge
WorkingDirectory=/opt/onvif-rtsp-bridge
ExecStart=/usr/bin/python3 -u src/onvif_proxy.py --config /etc/onvif-rtsp-bridge/config.json
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=onvif-rtsp-bridge.target
